NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
SESSION_SECRET=replace-with-at-least-32-random-bytes
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jansuvidha
MYSQL_USER=jansuvidha
MYSQL_PASSWORD=replace-me
MYSQL_TLS=false
# Local prototype only; production is blocked until staff MFA is implemented.
ALLOW_LOCAL_STAFF_WITHOUT_MFA=true
# Optional SMTP. Without SMTP, use the local CLI to issue development links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional privacy-preserving HIBP range lookup; fails closed if enabled and unavailable.
BREACHED_PASSWORD_CHECK=false
