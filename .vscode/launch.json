{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start JanSuvidha locally",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/server.mjs",
            "runtimeArgs": ["--env-file=.env"],
            "cwd": "${workspaceFolder}",
            "outputCapture": "std",
            "serverReadyAction": {
                "pattern": "JanSuvidha listening: (https?://\\S+)",
                "uriFormat": "%s/#login",
                "action": "openExternally"
            }
        },
        {
            "name": "Open running JanSuvidha in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:4173/#login",
            "webRoot": "${workspaceFolder}/dist"
        }
    ]
}
