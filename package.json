{
  "name": "jansuvidha-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file=.env scripts/server.mjs",
    "dev": "node --env-file=.env --watch scripts/server.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "auth:bootstrap": "node --env-file=.env scripts/auth-cli.mjs bootstrap",
    "auth:dev-link": "node --env-file=.env scripts/auth-cli.mjs dev-link",
    "test:auth": "node --env-file=.env scripts/auth-checks.mjs",
    "test": "node scripts/checks.mjs && node scripts/emergency-checks.mjs && node scripts/bus-checks.mjs && node scripts/import-checks.mjs && node scripts/map-checks.mjs && node scripts/walking-checks.mjs && node scripts/account-checks.mjs && node scripts/social-auth-checks.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "analyze": "node scripts/analysis.mjs",
    "android:sync": "cap sync android",
    "android:open": "node --env-file-if-exists=.env.android.local node_modules/@capacitor/cli/bin/capacitor open android",
    "android:run": "cap run android --no-sync",
    "data:import": "node scripts/import-thane.mjs && node scripts/import-bus.mjs",
    "prestart": "npm run map:assets && npm run data:import",
    "predev": "npm run map:assets && npm run data:import",
    "preandroid:sync": "npm run map:assets && npm run data:import",
    "map:assets": "node scripts/prepare-map-assets.mjs",
    "postandroid:sync": "node scripts/android-origin.mjs && node scripts/android-checks.mjs",
    "android:check": "node scripts/android-checks.mjs",
    "preandroid:open": "npm run android:sync",
    "preandroid:run": "npm run android:sync",
    "bus:fetch": "python bus-pipeline/pipeline.py",
    "bus:import": "node scripts/import-bus.mjs",
    "bus:test": "python bus-pipeline/test_pipeline.py",
    "auth:mfa": "node --env-file-if-exists=.env scripts/enroll-staff.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@inquirer/prompts": "^8.7.5",
    "argon2": "^0.45.2",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "leaflet": "^1.9.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.6.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "simple-statistics": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
