{
  "name": "jansuvidha-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "dev": "node --env-file=.env --watch server.mjs",
    "presentation": "node --env-file=.env presentation.mjs",
    "presentation:invite": "node --env-file=.env presentation.mjs dev-link",
    "db:setup": "node setup-db.mjs",
    "db:migrate": "node --env-file=.env migrate.mjs",
    "auth:bootstrap": "node --env-file=.env auth-cli.mjs bootstrap",
    "auth:dev-link": "node --env-file=.env auth-cli.mjs dev-link",
    "test:auth": "node --env-file=.env auth-checks.mjs",
    "test": "node checks.mjs && node import-checks.mjs && node map-checks.mjs && node account-checks.mjs && node presentation-checks.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "analyze": "node analysis.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "data:import": "node import-thane.mjs",
    "prestart": "npm run map:assets && npm run data:import",
    "predev": "npm run map:assets && npm run data:import",
    "preandroid:sync": "npm run map:assets && npm run data:import",
    "map:assets": "node prepare-map-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@inquirer/prompts": "^8.7.5",
    "argon2": "^0.45.2",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "leaflet": "^1.9.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "simple-statistics": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
